# Copy to .env (ignored by git), fill in, then: set -a; source .env; set +a
AWS_PROFILE=
AWS_REGION=us-east-1
# one of: haiku-5.5 | haiku-4.5 | nova-micro  (see lambda/shared/enums.py > ReaderModelChoice)
READER_MODEL=haiku-5.5

# RCS testing agent (infra/scripts/rcs_agent_setup.sh), slice 5 — fill the three personal values, keep the rest
RCS_BRAND_NAME=SendPidge
RCS_CONTACT_EMAIL=
RCS_CONTACT_PHONE=
RCS_TESTER_NUMBERS=
# Jimin's RCS number for the trust graph (scripts/seed_graph.py), E.164 like +821012345678
JIMIN_RCS_NUMBER=
# Jimin's WhatsApp number for the trust graph (scripts/seed_graph.py), slice 6, E.164 like +821012345678
JIMIN_WHATSAPP_NUMBER=
# Where Jimin's verdict receipts are emailed (scripts/seed_graph.py); any mailbox he reads
JIMIN_CONTACT_EMAIL=
RCS_PRIVACY_URL=https://app.sendpidge.com/privacy.html
RCS_TERMS_URL=https://app.sendpidge.com/terms.html
RCS_LOGO_PATH=infra/brand-assets/logo-224.png
RCS_BANNER_PATH=infra/brand-assets/banner-1440x448.png
# Addresses Jimin really writes from, comma-separated; gate 1 holds a "Jimin" email from any other address
JIMIN_KNOWN_ADDRESSES=jimin@example.com
