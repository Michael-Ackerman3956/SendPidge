# Copy to .env (ignored by git), fill in, then: set -a; source .env; set +a
AWS_PROFILE=
AWS_REGION=us-east-1
# one of: haiku-5.5 | haiku-4.5 | nova-micro  (see lambda/shared/enums.py > ReaderModelChoice)
READER_MODEL=haiku-5.5

# RCS testing agent (infra/scripts/rcs_agent_setup.sh), slice 5 — fill the three personal values, keep the rest
RCS_BRAND_NAME=SendPidge
RCS_CONTACT_EMAIL=
RCS_CONTACT_PHONE=
RCS_TESTER_NUMBERS=
RCS_PRIVACY_URL=https://app.sendpidge.com/privacy.html
RCS_TERMS_URL=https://app.sendpidge.com/terms.html
RCS_LOGO_PATH=infra/brand-assets/logo-224.png
RCS_BANNER_PATH=infra/brand-assets/banner-1440x448.png
